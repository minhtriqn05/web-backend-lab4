PORT=4000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lab4_shop

# JWT - use a long random string for the secret
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Optional: comma-separated list of allowed Web UI origins (default: any origin)
# CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
